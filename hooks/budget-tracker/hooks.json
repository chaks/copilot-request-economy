{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/budget-tracker/track-session.sh",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "COPILOT_HOOK_EVENT": "sessionStart"
        }
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/budget-tracker/track-session.sh",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "COPILOT_HOOK_EVENT": "sessionEnd"
        }
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/budget-tracker/track-prompt.sh",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "COPILOT_HOOK_EVENT": "userPromptSubmitted"
        }
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "~/.copilot/hooks/budget-tracker/track-prompt.sh",
        "cwd": ".",
        "timeoutSec": 5,
        "env": {
          "COPILOT_HOOK_EVENT": "postToolUse"
        }
      }
    ]
  }
}
